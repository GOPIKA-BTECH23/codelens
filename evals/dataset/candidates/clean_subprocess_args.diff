+def pdf_thumbnail(pdf_path: Path) -> Path:
+    out = THUMB_DIR / f"{uuid.uuid4().hex}.png"
+    subprocess.run(
+        ["pdftoppm", "-png", "-singlefile", "-scale-to", "256", str(pdf_path), str(out.with_suffix(""))],
