+"""Session cookies and uploaded settings."""
+
+import base64
+import pickle
+
+import yaml
+from flask import request
+
+
+def load_session(cookie_value: str) -> dict:
+    return pickle.loads(base64.b64decode(cookie_value))
+
+
+def import_settings() -> dict:
+    return yaml.load(request.data, Loader=yaml.Loader)
