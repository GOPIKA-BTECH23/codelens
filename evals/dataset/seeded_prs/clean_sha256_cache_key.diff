@@ -1,3 +1,14 @@
 """Rendered page cache."""
 
+import hashlib
+
 _CACHE: dict[str, bytes] = {}
+
+
+def cache_key(template: str, context_json: str) -> str:
+    digest = hashlib.sha256(f"{template}\0{context_json}".encode()).hexdigest()
+    return f"page:{digest}"
+
+
+def etag_for(body: bytes) -> str:
+    return '"' + hashlib.sha256(body).hexdigest()[:32] + '"'
