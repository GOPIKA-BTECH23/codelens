# CodeLens environment variables. Copy to .env and fill in. Never commit .env.
#
# FIRST-TIME SETUP:  cp .env.example .env    (Windows: copy .env.example .env)
# The repo-root .env serves two readers:
#   * local commands run from apps/api (alembic, pytest, seed, uvicorn) read it through
#     Settings, so DATABASE_URL here must use localhost and the PUBLISHED port;
#   * docker compose reads it only to fill ${...} placeholders (POSTGRES_*). The api
#     container gets its own DATABASE_URL (host `postgres`, port 5432) from docker-compose.yml,
#     so the value below never reaches the container.
# If you change POSTGRES_PORT / POSTGRES_PASSWORD, change DATABASE_URL to match.
# Placeholders only. "Required in" says which milestone first needs the variable.

# --- Core (required now, M0) ---
# Postgres connection string (asyncpg driver) for commands run on your machine, outside Docker.
# Port must equal POSTGRES_PORT below.
# Production (Supabase): use the SESSION pooler URL, not the transaction pooler.
DATABASE_URL=postgresql+asyncpg://codelens:codelens@localhost:5432/codelens
# Browser origin of the web app (used for CORS and redirects).
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
# development | test | production. Defaults to production when unset. The seed script only
# runs with `development` (and a localhost database).
ENVIRONMENT=development

# --- Public URLs (M2) ---
API_ORIGIN=http://localhost:8000

# --- Sessions (required from M2) ---
# Signs access tokens and the OAuth state cookie. At least 32 characters; the API refuses
# to start with this placeholder. Generate with: openssl rand -hex 32
# Changing it logs everyone out.
JWT_SECRET=change-me
# Access token lifetime (1-60). The web app refreshes it silently.
JWT_ACCESS_TTL_MINUTES=15
# Absolute session lifetime from login (1-30). Refreshing never extends it.
JWT_REFRESH_TTL_DAYS=7
# Requests per minute per client IP on /auth/* (optional, default 20).
# AUTH_RATE_LIMIT_PER_MINUTE=20

# --- GitHub App (M2 for login, M3 for the rest) ---
GITHUB_APP_ID=
# PEM contents, base64-encoded PEM, or a file path. Keep the key OUTSIDE the repo.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=change-me
# Required from M2. The GitHub App's own client ID/secret are used for user login
# (GitHub App settings -> General -> Client ID / "Generate a new client secret").
# The App's callback URL must be  <WEB_ORIGIN>/api/auth/github/callback
#   local: http://localhost:5173/api/auth/github/callback
# and it needs Organization permissions -> Members: Read-only (to map org owners to admin).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- LLM / embeddings (M5, M8) ---
# gemini | groq | fake
LLM_PROVIDER=fake
# gemini | fake
EMBEDDING_PROVIDER=fake
GEMINI_API_KEY=
GROQ_API_KEY=
# Model name is verified against provider docs in M8.
EMBEDDING_MODEL=
# Must equal EMBEDDING_DIM in apps/api/app/db/constants.py or the API refuses to start.
# Changing it needs a migration + full re-index (docs/adr/0001-database-schema.md).
EMBEDDING_DIM=768

# --- Observability (M7 Sentry, M11 Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

# --- Worker and cost control (M4) ---
# true = run the job worker as a background loop inside the API process (free-tier demos).
RUN_WORKER_IN_API=false
DAILY_COST_CAP_USD=5

# --- docker-compose only (M0, M1) ---
POSTGRES_USER=codelens
POSTGRES_PASSWORD=codelens
POSTGRES_DB=codelens
# Host port for the compose Postgres. Change it if 5432 is already taken on your machine
# (then use the same port in DATABASE_URL / TEST_DATABASE_URL when running outside Docker).
POSTGRES_PORT=5432
# Optional: database the API tests wipe and use. Must be named *_test.
# TEST_DATABASE_URL=postgresql+asyncpg://codelens:codelens@localhost:5432/codelens_test
