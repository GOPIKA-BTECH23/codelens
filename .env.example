# CodeLens environment variables. Copy to .env and fill in. Never commit .env.
#
# FIRST-TIME SETUP:  cp .env.example .env    (Windows: copy .env.example .env)
# The repo-root .env serves two readers:
#   * local commands run from apps/api (alembic, pytest, seed, uvicorn) read it through
#     Settings, so DATABASE_URL here must use localhost and the PUBLISHED port;
#   * docker compose reads it only to fill ${...} placeholders (POSTGRES_*). The api
#     container gets its own DATABASE_URL (host `postgres`, port 5432) from docker-compose.yml,
#     so the value below never reaches the container.
# If you change POSTGRES_PORT / POSTGRES_PASSWORD, change DATABASE_URL to match.
# Placeholders only. "Required in" says which milestone first needs the variable.

# --- Core (required now, M0) ---
# Postgres connection string (asyncpg driver) for commands run on your machine, outside Docker.
# Port must equal POSTGRES_PORT below.
# Production (Supabase): use the SESSION pooler URL, not the transaction pooler.
DATABASE_URL=postgresql+asyncpg://codelens:codelens@localhost:5432/codelens
# Browser origin of the web app (used for CORS and redirects).
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
# development | test | production. Defaults to production when unset. The seed script only
# runs with `development` (and a localhost database).
ENVIRONMENT=development

# --- Public URLs (M2) ---
API_ORIGIN=http://localhost:8000

# --- Sessions (required from M2) ---
# Signs access tokens and the OAuth state cookie. At least 32 characters; the API refuses
# to start with this placeholder. Generate with: openssl rand -hex 32
# Changing it logs everyone out.
JWT_SECRET=change-me
# Access token lifetime (1-60). The web app refreshes it silently.
JWT_ACCESS_TTL_MINUTES=15
# Absolute session lifetime from login (1-30). Refreshing never extends it.
JWT_REFRESH_TTL_DAYS=7
# Requests per minute per client IP on /auth/* (optional, default 20).
# AUTH_RATE_LIMIT_PER_MINUTE=20

# --- GitHub App (M2 for login, M3 for webhooks and app auth) ---
# Required from M2. The GitHub App's own client ID/secret are used for user login
# (GitHub App settings -> General -> Client ID / "Generate a new client secret").
# The client ID is also the `iss` of the App's JWT (GitHub's recommendation), so there is
# no separate GITHUB_APP_ID.
# The App's callback URL must be  <WEB_ORIGIN>/api/auth/github/callback
#   local: http://localhost:5173/api/auth/github/callback
# and it needs Organization permissions -> Members: Read-only (to map org owners to admin).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Required from M3. Paste the SAME value into GitHub App settings -> Webhook secret.
# At least 16 characters; the API refuses to start with this placeholder.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=change-me
# Required by the worker from M5 (it posts reviews as the App; the API alone does not need
# it). Keep the .pem OUTSIDE the repo. Accepted forms, checked at startup when set:
#   * a path:            GITHUB_APP_PRIVATE_KEY=C:/Users/you/keys/codelens-dev.private-key.pem
#   * base64 of the PEM: GITHUB_APP_PRIVATE_KEY=LS0tLS1CRUdJTi...   (needed for docker compose:
#     a host path does not exist inside the container)
#     make it with:  python -c "import base64,sys;print(base64.b64encode(open(sys.argv[1],'rb').read()).decode())" key.pem
#   * the PEM text itself (with real newlines, or each written as the two characters \n).
GITHUB_APP_PRIVATE_KEY=
# PR authors we never review, comma-separated (optional; this is the default).
# WEBHOOK_IGNORED_PR_AUTHORS=dependabot[bot],renovate[bot]

# --- LLM (M5) ---
# Which model reviews PRs: groq (default) | gemini | fake. `fake` never calls an AI and says so
# in the review; the worker refuses it when ENVIRONMENT=production. The worker checks at
# startup that the chosen provider's key is set (the API process alone does not need it).
LLM_PROVIDER=groq
# Empty = the provider's default: groq -> openai/gpt-oss-120b, gemini -> gemini-3.8-flash
# (both confirmed in the providers' model lists on 2026-10-17). Any other model needs a price
# in apps/api/app/ai/llm/pricing.py first.
LLM_MODEL=
# Keys from https://console.groq.com/keys and https://aistudio.google.com/apikey. Paste the
# bare value: no quotes, no <brackets>, no spaces (checked at startup; never printed).
GROQ_API_KEY=
GEMINI_API_KEY=
# Client-side cap on LLM calls started per minute. Keep it under your plan's limit.
LLM_REQUESTS_PER_MINUTE=20
# Seconds per LLM call, and how often the SDK retries a 429/5xx itself before the job queue
# takes over (Gemini's SDK always retries at least once).
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Review policy (M5) ---
# Findings below this confidence (0-1) are not posted; the summary counts them.
REVIEW_CONFIDENCE_THRESHOLD=0.6
# At most this many inline comments per PR (1-50); the rest are counted in the summary.
REVIEW_MAX_COMMENTS=15
# Extra paths to skip, comma-separated, on top of the built-in list (lockfiles, vendor/,
# node_modules/, dist/, *.min.js, generated code ...). Forms: `dir/`, `*.ext`, `path/*.py`.
REVIEW_IGNORE_PATTERNS=
# Files with more changed lines than this are skipped as too large.
REVIEW_MAX_FILE_CHANGED_LINES=1000
# PRs with only docs, lockfiles, generated or binary files: skip (run marked skipped, nothing
# posted) | comment (post a short "nothing to review" summary).
REVIEW_NO_CODE_BEHAVIOR=skip
# Estimated diff tokens per LLM call (bigger PRs are split), and calls in flight per review.
REVIEW_CHUNK_MAX_TOKENS=12000
REVIEW_LLM_CONCURRENCY=2

# --- Embeddings (M8) ---
# gemini | fake
EMBEDDING_PROVIDER=fake
# Model name is verified against provider docs in M8.
EMBEDDING_MODEL=
# Must equal EMBEDDING_DIM in apps/api/app/db/constants.py or the API refuses to start.
# Changing it needs a migration + full re-index (docs/adr/0001-database-schema.md).
EMBEDDING_DIM=768

# --- Observability (M7 Sentry, M11 Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Empty = Sentry is off and nothing is sent. Scrubbing of cookies/bodies/user info is always on.
SENTRY_DSN=
# Web build only (Vercel env var): same idea for browser errors. Unset = SDK not loaded.
# VITE_SENTRY_DSN=

# --- Deployment (M7; docs/deployment.md has the full per-service table) ---
# Connection pool per process. Production uses 3 / 2 (Supabase free pooler has few slots).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Worker and cost control (M4) ---
# true = run the job worker as a background loop inside the API process (free-tier demos).
# false = run it as its own process: `python -m app.worker.main` (docker compose does this).
RUN_WORKER_IN_API=false
# Runs are marked `skipped` once today's (UTC) estimated spend reaches this. The spend is the
# estimated cost at list price recorded on each run (M5), even on free tiers.
DAILY_COST_CAP_USD=5   # production uses 1 (docs/deployment.md)
# Jobs handled at the same time by one worker (1-20).
WORKER_CONCURRENCY=2
# Idle sleep between empty polls, seconds (randomised +-50% so workers do not poll in step).
WORKER_POLL_SECONDS=2
# A `running` job older than this is presumed abandoned and re-queued. Keep it longer than your
# slowest handler (a big review), or healthy jobs get run twice.
JOB_VISIBILITY_TIMEOUT_SECONDS=300
# On SIGTERM, how long running jobs may finish before they are released back to the queue.
# Keep it below the container's stop timeout (compose uses 30s).
WORKER_SHUTDOWN_GRACE_SECONDS=20

# --- docker-compose only (M0, M1) ---
POSTGRES_USER=codelens
POSTGRES_PASSWORD=codelens
POSTGRES_DB=codelens
# Host port for the compose Postgres. Change it if 5432 is already taken on your machine
# (then use the same port in DATABASE_URL / TEST_DATABASE_URL when running outside Docker).
POSTGRES_PORT=5432
# Optional: database the API tests wipe and use. Must be named *_test.
# TEST_DATABASE_URL=postgresql+asyncpg://codelens:codelens@localhost:5432/codelens_test
